# Quiz app config — copy to .env and edit.
# In Docker this template and .env are injected at run time by compose
# env_file (never baked into the image); compose environment: entries and
# real OS env outrank both files' keys where the app reads them.
# DB_HOST is intentionally NOT set here:
#   local (go run / go test) -> 127.0.0.1 (built-in default)
#   docker compose           -> db (supplied by compose environment)
GURU_USER=guru
GURU_PASS=changeme
DB_USER=quiz
DB_PASS=quizpass
DB_NAME=quiz
DB_PORT=3306
PORT=8090
